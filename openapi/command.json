        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResult"
                }
              },
