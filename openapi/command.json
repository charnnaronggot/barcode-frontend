  "components": {
    "schemas": {
      "BarcodeInput": {
        "required": [
          "comp",
          "tax",
          "suffix",
          "ref1",
          "textLevel1",
          "textLevel2",
          "textLevel3"
        ],
        "type": "object",
        "properties": {
          "id": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["null", "integer", "string"],
            "format": "int32"
          },
          "branchId": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "comp": {
            "maxLength": 13,
            "type": "string"
          },
          "tax": {
            "maxLength": 13,
            "type": "string"
          },
          "suffix": {
            "maxLength": 2,
            "type": "string"
          },
          "ref1": {
            "maxLength": 15,
            "type": "string"
          },
          "ref2": {
            "maxLength": 15,
            "type": ["null", "string"]
          },
          "ref3": {
            "maxLength": 15,
            "type": ["null", "string"]
          },
          "textLevel1": {
            "type": "string"
          },
          "textLevel2": {
            "type": "string"
          },
          "textLevel3": {
            "type": "string"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["null", "number", "string"],
            "format": "double"
          }
        }
      },
      "BranchUpdate": {
        "required": ["name", "isActive"],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "DraftUpdate": {
        "required": ["data", "rowVersion"],
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/BarcodeInput"
          },
          "rowVersion": {
            "type": "string"
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "ImportError": {
        "required": ["row", "column", "message"],
        "type": "object",
        "properties": {
          "row": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "column": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ImportPreview": {
        "required": ["sheets", "sheet", "headers", "sample", "count", "errors"],
        "type": "object",
        "properties": {
          "sheets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sheet": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "headers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sample": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportError"
            }
          }
        }
      },
      "MutationResult": {
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["null", "integer", "string"],
            "format": "int32"
          },
          "branchId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["null", "integer", "string"],
            "format": "int32"
          },
          "uuid": {
            "type": ["null", "string"],
            "format": "uuid"
          },
          "fileType": {
            "type": ["null", "string"]
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["null", "integer", "string"],
            "format": "int32"
          },
          "ids": {
            "type": ["null", "array"],
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": ["integer", "string"],
              "format": "int32"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://oidc.app.baac.or.th/realms/baac/protocol/openid-connect/auth",
            "tokenUrl": "https://oidc.app.baac.or.th/realms/baac/protocol/openid-connect/token",
            "scopes": {
              "openid": "OpenID",
              "profile": "Profile"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "Bearer": ["openid"]
    }
  ],
