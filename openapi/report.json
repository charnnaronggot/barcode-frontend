{
  "openapi": "3.1.1",
  "info": {
    "title": "Report | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5433/"
    }
  ],
  "paths": {
    "/api/barcodes/{id}/generate": {
      "post": {
        "tags": ["BarcodeData"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "ContentType": {
                        "type": "string"
                      },
                      "ContentDisposition": {
                        "type": "string"
                      },
                      "Headers": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "Length": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": ["integer", "string"],
                        "format": "int64"
                      },
                      "Name": {
                        "type": "string"
                      },
                      "FileName": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "draftVersion": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/barcodes/branches/{branchId}/merged": {
      "get": {
        "tags": ["BarcodeData"],
        "parameters": [
          {
            "name": "branchId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/files/{uuid}": {
      "get": {
        "tags": ["BarcodeFiles"],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/barcodes/generation-jobs": {
      "post": {
        "tags": ["BulkGeneration"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/BulkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BulkProgress"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkProgress"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkProgress"
                }
              }
            }
          }
        }
      }
    },
    "/api/barcodes/generation-jobs/{id}": {
      "get": {
        "tags": ["BulkGeneration"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BulkProgress"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkProgress"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkProgress"
                }
              }
            }
          }
        }
      }
    },
    "/api/barcodes/generation-jobs/{id}/retry": {
      "post": {
        "tags": ["BulkGeneration"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BulkProgress"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkProgress"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkProgress"
                }
              }
            }
          }
        }
      }
    },
    "/Barcode": {
      "get": {
        "tags": ["Legacy"],
        "parameters": [
          {
            "name": "compCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/FileContentResult"
                }
              }
            }
          }
        }
      }
    },
    "/Barcode/by-id": {
      "get": {
        "tags": ["Legacy"],
        "parameters": [
          {
            "name": "compCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": ["integer", "string"],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/FileContentResult"
                }
              }
            }
          }
        }
      }
    },
    "/Barcode/generate-pdf": {
      "post": {
        "tags": ["Legacy"],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "csvFile": {
                    "$ref": "#/components/schemas/IFormFile"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/FileContentResult"
                }
              }
            }
          }
        }
      }
    },
    "/Barcode/preview-form": {
      "post": {
        "tags": ["Legacy"],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "PdfFile": {
                    "$ref": "#/components/schemas/IFormFile"
                  },
                  "Data": {
                    "$ref": "#/components/schemas/IFormFile"
                  },
                  "FontSize": {
                    "pattern": "^-?(?:0|[1-9]\\d*)$",
                    "type": ["integer", "string"],
                    "format": "int16"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/FileContentResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BulkFailure": {
        "required": ["id", "message"],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "BulkProgress": {
        "required": [
          "id",
          "status",
          "total",
          "succeeded",
          "skipped",
          "failed",
          "errors"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "succeeded": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "skipped": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "failed": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkFailure"
            }
          }
        }
      },
      "BulkRequest": {
        "type": "object",
        "properties": {
          "ids": {
            "type": ["null", "array"],
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": ["integer", "string"],
              "format": "int32"
            }
          }
        }
      },
      "EntityTagHeaderValue": {
        "type": "object",
        "properties": {
          "tag": {
            "$ref": "#/components/schemas/StringSegment"
          },
          "isWeak": {
            "type": "boolean"
          }
        }
      },
      "FileContentResult": {
        "type": "object",
        "properties": {
          "fileContents": {
            "type": "string",
            "format": "byte"
          },
          "contentType": {
            "type": ["null", "string"]
          },
          "fileDownloadName": {
            "type": ["null", "string"]
          },
          "lastModified": {
            "type": ["null", "string"],
            "format": "date-time"
          },
          "entityTag": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EntityTagHeaderValue"
              }
            ]
          },
          "enableRangeProcessing": {
            "type": "boolean"
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "MutationResult": {
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["null", "integer", "string"],
            "format": "int32"
          },
          "branchId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["null", "integer", "string"],
            "format": "int32"
          },
          "uuid": {
            "type": ["null", "string"],
            "format": "uuid"
          },
          "fileType": {
            "type": ["null", "string"]
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["null", "integer", "string"],
            "format": "int32"
          },
          "ids": {
            "type": ["null", "array"],
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": ["integer", "string"],
              "format": "int32"
            }
          }
        }
      },
      "StringSegment": {
        "type": "object",
        "properties": {
          "buffer": {
            "type": ["null", "string"]
          },
          "offset": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "length": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "value": {
            "type": ["null", "string"]
          },
          "hasValue": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://oidc.app.baac.or.th/realms/baac/protocol/openid-connect/auth",
            "tokenUrl": "https://oidc.app.baac.or.th/realms/baac/protocol/openid-connect/token",
            "scopes": {
              "openid": "OpenID",
              "profile": "Profile"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "Bearer": ["openid"]
    }
  ],
  "tags": [
    {
      "name": "BarcodeData"
    },
    {
      "name": "BarcodeFiles"
    },
    {
      "name": "BulkGeneration"
    },
    {
      "name": "Legacy"
    }
  ]
}
